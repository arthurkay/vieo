[Unit]
Description=Vieo Video Streaming Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vieo
Group=vieo
WorkingDirectory=/opt/vieo
ExecStart=/opt/vieo/vieo
Restart=on-failure
RestartSec=5

# Environment — override as needed. VIEO_JWT_SECRET is auto-generated and
# persisted to <VIEO_DATA_DIR>/.jwt_secret on first run, so it can be omitted.
Environment=VIEO_HTTP_ADDR=:8080
Environment=VIEO_DB_PATH=/opt/vieo/vieo.db
Environment=VIEO_DATA_DIR=/opt/vieo/data
# Environment=VIEO_M3U_FILE=/opt/vieo/playlist.m3u
# Environment=VIEO_MAX_JOBS=3
# Environment=VIEO_DISK_WARN=90
# Environment=VIEO_DISK_CRIT=95
# Environment=VIEO_WATERMARK=true
# Environment=VIEO_AUTH_ENABLED=true

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vieo
PrivateTmp=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
